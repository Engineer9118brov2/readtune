# Vercel hosts the public microsite, not the unpacked extension payload.
# Keep lib/fonts/ — site.css loads the woff2 files from there.
lib/*.js
lib/*.txt
lib/*.md
test/
store/
scripts/
shared/
dist/
.chrome-ci/
*.zip
*.log
lab.html
lab.js
lab.css
calibration.html
calibration.js
calibration.css
reader.html
reader.js
reader.css
popup.html
popup.js
popup.css
inpage.js
inpage.css
background.js
manifest.json
# Anchored to the repo root: the microsite build must not see the extension's
# package.json (its "build" script produces the .zip). But api/package.json —
# which only sets "type": "module" so Vercel runs the handlers as native ESM
# instead of compiling them to CommonJS — must ship.
/package.json
/package-lock.json
README.md
PRIVACY.md
